
cabal-version:   3.12
name:            swinging-wheel-backend
version:         0.1.0.0
license:         NONE
author:          Unknown
maintainer:      Unknown
build-type:      Simple
extra-doc-files: CHANGELOG.md

common warnings
    ghc-options: -Wall

executable swinging-wheel-backend
    import:           warnings
    main-is:          Main.hs
    build-depends:    base ^>=4.18.3.0,
		      scotty,
		      text
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:      -threaded
